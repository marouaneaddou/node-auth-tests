  "scripts": {
    "migrate:test": "npx dotenv -e .env.test -- npx prisma migrate dev",
    "migrate:ci": "prisma migrate deploy",
    "migrate:dev": "npx dotenv -e .env -- npx prisma migrate dev",
    "dev": "npx dotenv -e .env -- npx prisma migrate dev && NODE_ENV=dev nodemon src/index.ts",
    "build": "npx tsc",
    "test": "NODE_ENV=test jest",
    "test:coverage": "NODE_ENV=test jest --coverage"
  },
  "dependencies": {
